DATABASE_URL="postgresql://tikiacca:tikiacca@localhost:5432/tiki_acca"
AUTH_SECRET="dev-secret-change-in-production-tiki-acca-2026"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# The Odds API (https://the-odds-api.com/) — omit to use mock fixtures
# ODDS_API_KEY="your-api-key"
# ODDS_API_SPORT="soccer_fifa_world_cup"
# ODDS_API_REGIONS="uk"
# Snapshot TTL. Must exceed the warm-cron interval when ODDS_DB_ONLY=true,
# or expired snapshots are never refetched and fixtures come back empty.
# Production uses 25200000 (7h) against a 6h cron.
# ODDS_API_CACHE_TTL_MS="1800000"
# ODDS_DB_ONLY="true"
# ODDS_WARM_CORE_WITHIN_HOURS="72"
# Season-long outrights. Off unless "true". The Odds API serves no soccer
# outrights, so leave this off until a provider does — docs/ODDS_PROVIDERS.md.
# OUTRIGHTS_ENABLED="false"
# ODDS_OUTRIGHT_CACHE_TTL_MS="43200000"
# ODDS_OUTRIGHT_FAILURE_TTL_MS="3600000"

# Estimated-odds fill (median-backfill for thin bookmaker tables). Off unless
# "true" — docs/specs/estimated-odds-fill.md. This is the deploy-level kill
# switch; an admin runtime toggle (/admin/odds) additionally gates the fill
# once this is on — both must be enabled.
# ESTIMATED_ODDS_ENABLED="false"
# Haircut: estimate = median x (1 - margin). Clamped to [0.01, 0.5]; <= 0 falls back to 0.05.
# ESTIMATED_ODDS_MARGIN="0.05"
# Minimum real quotes required before a selection is backfilled.
# ESTIMATED_ODDS_MIN_REAL_QUOTES="2"
# Skip filling once real-quote count reaches this threshold.
# ESTIMATED_ODDS_SKIP_AT="4"

# football-data.org (https://www.football-data.org/) — match sync + auto-settle
# FOOTBALL_DATA_API_KEY="your-api-key"
# FOOTBALL_DATA_CACHE_TTL_MS="60000"

# Email notifications (Resend — https://resend.com/) — omit to skip emails
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Tiki Acca <notifications@tikiacca.com>"

# Expo push (optional — higher rate limits for POST https://exp.host/--/api/v2/push/send)
# EXPO_ACCESS_TOKEN="..."

# Cron secret for POST /api/internal/* cron routes (Cloud Scheduler)
# CRON_SECRET="generate-a-long-random-string"

# Comma-separated developer emails granted platform admin ( /admin dashboard )
# ADMIN_EMAILS="you@example.com,teammate@example.com"

# Optional: single allowed origin for API CORS in production
# ALLOWED_ORIGIN="https://tikiacca.example.com"

# Optional: block direct-to-Cloud-Run traffic that bypasses Cloudflare.
# Set the same value in a Cloudflare Transform Rule that adds the
# x-origin-auth request header. Unset = check disabled (local dev).
# See docs/DEPLOYMENT.md → "DDoS & abuse protection".
# ORIGIN_AUTH_SECRET="generate-a-long-random-string"

# Affiliate tracking (optional, per bookmaker). Value is the raw query
# fragment issued by the affiliate programme; it is appended to every
# outbound link for that bookmaker (deeplinks, ranked links, hubs).
# Key format: AFFILIATE_<BOOKMAKER_ID>_PARAMS (id uppercased, non-alphanumerics -> _)
# AFFILIATE_BET365_PARAMS="affiliate=365_012345"
# AFFILIATE_PADDYPOWER_PARAMS="AFF_ID=12345"
