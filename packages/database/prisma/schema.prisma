generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  firstName    String
  lastName     String
  /// Full display name (`firstName lastName`) for leaderboards, picks, emails.
  name         String
  email        String        @unique
  /// Set when the user clicks the link in their verification email (or
  /// completes a password reset, which proves the same thing). Null = the
  /// account is gated to the verify-email screen until they confirm.
  emailVerifiedAt DateTime?
  /// Date of birth captured at sign-up for 18+ age verification. Nullable so
  /// pre-existing accounts (created before this was collected) are grandfathered.
  dateOfBirth  DateTime?     @db.Date
  passwordHash String
  role         String        @default("user")
  totalPoints  Float         @default(0)
  legsWon      Int           @default(0)
  legsLost     Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  ownedGroups  Group[]       @relation("GroupOwner")
  memberships  GroupMember[]
  legs         Leg[]
  analyticsEvents AnalyticsEvent[]
  pushDevices     PushDevice[]
  notificationPreference NotificationPreference?
  notificationLogs NotificationLog[]
  roundMessages    RoundMessage[]
  messageReactions MessageReaction[]
  mobileSessions   MobileSession[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  messageReports   MessageReport[] @relation("MessageReports")
  blocksMade       UserBlock[]     @relation("BlocksMade")
  blocksReceived   UserBlock[]     @relation("BlocksReceived")
}

/// Single-use, expiring token for the forgot-password flow. Only a SHA-256
/// hash of the emailed token is stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Single-use, expiring token for confirming an email address. Only a SHA-256
/// hash of the emailed token is stored. `email` pins the token to the address
/// it was sent to, so a link sent before an email change can't verify the new one.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Revocable, non-expiring device session for the native app.
/// Only a SHA-256 hash of the bearer token is stored.
model MobileSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model Group {
  id             String        @id @default(cuid())
  name           String
  inviteCode     String        @unique
  sport          String        @default("football")
  maxMembers     Int           @default(10)
  /// Legs each member must submit per round (1–3). Applies to newly opened rounds.
  legsPerMember  Int           @default(1)
  /// Maximum simultaneous open or locked bets (1–5).
  maxActiveBets  Int           @default(1)
  status         String        @default("open")
  ownerId        String
  owner          User          @relation("GroupOwner", fields: [ownerId], references: [id])
  members        GroupMember[]
  rounds         Round[]
  messages       RoundMessage[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model GroupMember {
  id                String    @id @default(cuid())
  groupId           String
  userId            String
  role              String    @default("member")
  points            Float     @default(0)
  legsWon           Int       @default(0)
  legsLost          Int       @default(0)
  joinedAt          DateTime  @default(now())
  lastReadMessageAt DateTime?
  group             Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId, lastReadMessageAt])
}

model Round {
  id              String   @id @default(cuid())
  groupId         String
  /// Stable, group-scoped display number. Nullable for compatibility with direct test fixtures.
  betNumber       Int?
  status          String   @default("open")
  /// Snapshot of group.legsPerMember when this round opened.
  legsPerMember   Int      @default(1)
  /// True when this round opened in a one-member (solo) group: the quota is
  /// SOLO_MAX_LEGS and the member may lock the acca manually.
  unlimitedLegs   Boolean  @default(false)
  combinedOdds    Float?
  bestBookmakerId String?
  accaBookmakerRankings Json?
  stakeGbp        Float    @default(10)
  profitLossGbp   Float?
  lockedAt        DateTime?
  /// Set when a locked round reopens because a leg went void (postponed,
  /// cancelled…) before the other legs kicked off. The owner can swap the pick
  /// until the first remaining kickoff; the round re-locks then, or as soon
  /// as no void legs remain.
  reopenedAt      DateTime?
  settledAt       DateTime?
  lockedNotificationSentAt  DateTime?
  settledNotificationSentAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  group           Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  legs            Leg[]
  messages        RoundMessage[]

  @@unique([groupId, betNumber])
  @@index([groupId, status, createdAt])
}

model Leg {
  id            String   @id @default(cuid())
  roundId       String
  userId        String
  /// 1-based slot within the member's quota for this round.
  legIndex      Int      @default(1)
  fixtureId     String
  homeTeam      String
  awayTeam      String
  competitionId String   @default("world-cup")
  competition   String
  matchId       String?
  kickoff       DateTime
  marketType    String
  marketLabel   String
  selectionId   String
  selectionLabel String
  odds          Float
  bookmakerId   String
  bookmakerName String
  betslipUrl    String?
  bookmakerLinks Json?
  outcome       String   @default("pending")
  pointsAwarded Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  round         Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  match         Match?   @relation(fields: [matchId], references: [id])
  messages      RoundMessage[]

  @@unique([roundId, userId, legIndex])
}

model Match {
  id             String    @id @default(cuid())
  competitionId  String
  kickoff        DateTime
  homeTeam       String
  awayTeam       String
  status         String    @default("SCHEDULED")
  homeGoals      Int?
  awayGoals      Int?
  /// First time we observed FINISHED (or equivalent) from the results feed.
  finishedAt     DateTime?
  /// Last time the terminal FT score (homeGoals/awayGoals) changed from the
  /// feed. Leg outcomes are written provisionally at FT; round settlement
  /// waits RESULT_CONFIRMATION_MS after this (capped by
  /// RESULT_CONFIRMATION_MAX_MS from finishedAt) so VAR / disallowed-goal
  /// corrections can land before an acca is busted or won.
  scoreStableSince DateTime?
  /// When true, sync will not overwrite status/score — admin override wins.
  scoreLocked    Boolean   @default(false)
  externalOddsId String?   @unique
  externalDataId Int?      @unique
  lastSyncedAt   DateTime?
  /// Half-time score (canonical orientation), when a provider reports it.
  homeGoalsHt    Int?
  awayGoalsHt    Int?
  /// True when the match went to extra time / penalties. Goals stay 90-minute;
  /// corners stats cover the whole match, so corners legs go to admin.
  wentToExtraTime Boolean  @default(false)
  /// Canonical match stats `{ corners, yellowCards, redCards }` each
  /// `{ home, away }` (API-Football only). Stats-based legs wait until these
  /// are unchanged for STATS_CONFIRMATION_MS.
  stats          Json?
  statsStableSince DateTime?
  /// How the canonical result was reached: agreed | single | conflict | abstain.
  /// `conflict` / `abstain` hold auto-settle until sources agree or an admin locks.
  resultSource   String?
  /// Last failed attempt to map this match to an API-Football fixture
  /// (negative cache so unmapped matches are retried hourly, not every run).
  apiFootballCheckedAt DateTime?
  legs           Leg[]
  observations   MatchObservation[]

  @@index([competitionId, kickoff])
}

/// One results provider's view of a match (docs/specs/odds-and-results-sourcing.md §3.1).
/// `Match` stays canonical; resolveMatchConsensus() writes it from these rows.
/// Scores are stored in the Match's home/away orientation.
model MatchObservation {
  id           String   @id @default(cuid())
  matchId      String
  /// api_football | football_data
  provider     String
  /// Provider fixture id.
  externalId   String
  /// True when the provider lists the fixture with home/away swapped.
  reversed     Boolean  @default(false)
  /// Normalised to football-data vocabulary (SCHEDULED, IN_PLAY, FINISHED, POSTPONED, …).
  status       String
  /// 90-minute score. Null when the provider can't give the regulation split.
  homeGoals90  Int?
  awayGoals90  Int?
  /// Latest score including extra time (live score while in play).
  homeGoalsEnd Int?
  awayGoalsEnd Int?
  homeGoalsHt  Int?
  awayGoalsHt  Int?
  extraTime    Boolean  @default(false)
  stats        Json?
  observedAt   DateTime @default(now())
  /// Last change to any settled field (status, scores, stats).
  changedAt    DateTime @default(now())
  match        Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, provider])
  @@unique([provider, externalId])
}

/// Team-name equivalences across providers (normalised names), auto-learned
/// when a fixture maps unambiguously on one side.
model TeamAlias {
  id            String   @id @default(cuid())
  competitionId String?
  alias         String
  canonical     String
  /// auto | admin
  source        String
  createdAt     DateTime @default(now())

  @@unique([alias, canonical])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String
  userId    String?
  /// Originating client. Null only for events recorded before channel tracking.
  channel   String?
  path      String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([createdAt])
  @@index([userId, channel, createdAt])
}

model CompetitionSetting {
  id            String   @id @default(cuid())
  competitionId String   @unique
  enabled       Boolean  @default(false)
  updatedAt     DateTime @updatedAt
}

/// Generic admin-managed runtime toggles (smallest key/value store consistent
/// with CompetitionSetting's pattern). Currently used for the estimated-odds
/// fill runtime kill switch — see docs/specs/estimated-odds-fill.md §4.
model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

/// Cached bulk fixture list (h2h, totals, spreads) per competition — refreshed by cron.
model OddsBulkSnapshot {
  competitionId String   @id
  sport         String
  regions       String
  fixtures      Json
  fetchedAt     DateTime @default(now())
  expiresAt     DateTime

  @@index([expiresAt])
}

/// Cached per-event extended markets per tier — refreshed by cron.
model OddsEventSnapshot {
  competitionId String
  fixtureId     String
  tierId        String
  markets       Json
  fetchedAt     DateTime @default(now())
  expiresAt     DateTime

  @@id([competitionId, fixtureId, tierId])
  @@index([expiresAt])
}

/// Cached outright/futures markets (e.g. league winner) per competition —
/// refreshed by cron on a much longer interval than match odds.
model OutrightSnapshot {
  competitionId String   @id
  sport         String
  markets       Json
  fetchedAt     DateTime @default(now())
  expiresAt     DateTime

  @@index([expiresAt])
}

model PushDevice {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastUsedAt DateTime @default(now())

  @@index([userId])
}

model NotificationPreference {
  id                 String @id @default(cuid())
  userId             String @unique
  user               User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailPickReminder  Boolean @default(true)
  emailRoundLocked   Boolean @default(true)
  emailRoundSettled  Boolean @default(true)
  pushPickReminder   Boolean @default(true)
  pushRoundLocked    Boolean @default(true)
  pushRoundSettled   Boolean @default(true)
  pushChat           Boolean @default(true)
  updatedAt          DateTime @updatedAt
}

/// Longstanding group chat — user banter plus append-only round lifecycle
/// messages. `roundId` is optional context for bet-specific system events.
model RoundMessage {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  roundId   String?
  round     Round?   @relation(fields: [roundId], references: [id], onDelete: SetNull)
  userId    String?  // null for system messages
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind      String   // "user" | "system"
  body      String   // user text (max 500 chars) or system event copy
  eventType String?  // system only: leg_submitted | leg_changed | leg_removed | round_locked | leg_result | round_settled
  legId     String?  // system pick events: the announced leg — lets the betslip row find its message
  leg       Leg?     @relation(fields: [legId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  reactions MessageReaction[]
  reports   MessageReport[]

  @@index([groupId, createdAt])
  @@index([roundId, createdAt])
  @@index([legId])
}

model MessageReaction {
  id        String       @id @default(cuid())
  messageId String
  message   RoundMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String // constrained set — see REACTION_EMOJIS in packages/shared
  createdAt DateTime     @default(now())

  @@unique([messageId, userId, emoji])
}

model NotificationLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  roundId   String?
  groupId   String?
  channel   String
  sentAt    DateTime @default(now())

  @@unique([userId, type, roundId, channel])
  @@index([roundId])
}

/// A member's report of a chat message (App Review 1.2 — UGC moderation).
model MessageReport {
  id         String       @id @default(cuid())
  messageId  String
  message    RoundMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User         @relation("MessageReports", fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String?
  status     String       @default("open") // open | resolved
  createdAt  DateTime     @default(now())

  @@unique([messageId, reporterId])
  @@index([status, createdAt])
}

/// One user hiding another's chat messages (App Review 1.2 — abusive users).
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
}
